{
	"name": "68publishers/user",
	"description": "Provides user management for your Nette project.",
	"keywords": ["68publishers", "user", "management"],
	"license": "MIT",
	"authors": [
		{
			"name": "Vojtěch Lacina",
			"email": "MoraviaD1@gmail.com"
		},
		{
			"name": "Tomáš Glawaty",
			"email": "tomasglawaty@icloud.com"
		}
	],
	"require": {
		"php": "^8.3",
		"68publishers/doctrine-bridge": "^2.0",
		"68publishers/doctrine-persistence": "^0.4",
		"68publishers/doctrine-query-objects": "^0.3",
		"68publishers/smart-nette-component": "^2.0",
		"68publishers/translation-bridge": "^3.0",
		"doctrine/orm": "^2.10 || ^3.0",
		"matomo/device-detector": "^4.0 || ^5.0 || ^6.0",
		"nette/application": "^3.1",
		"nette/di": "^3.1.3",
		"nette/forms": "^3.0",
		"nette/http": "^3.0",
		"nette/security": "^3.1.8",
		"nette/utils": "^3.2.10 || ^4.0.1",
		"ramsey/uuid": "^4.1",
		"symfony/event-dispatcher": "^5.1 || ^6.0 || ^7.0 || ^8.0",
		"tracy/tracy": "^2.6"
	},
	"require-dev": {
		"contributte/mailing": "^0.5 || ^0.6 || ^0.7",
		"doctrine/annotations": "^1.13 || ^2.0",
		"friendsofphp/php-cs-fixer": "^3.75",
		"nette/tester": "^2.6",
		"psr/log": "^1.0 || ^2.0 || ^3.0",
		"roave/security-advisories": "dev-latest",
		"symfony/var-exporter": "^6.4 || ^7.0"
	},
	"suggest": {
		"contributte/mailing": "If you want to use default mail sender."
	},
	"autoload": {
		"psr-4": {
			"SixtyEightPublishers\\User\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SixtyEightPublishers\\User\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
